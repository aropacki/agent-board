{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.agent-board/bin/journal-hook.py\" claude-code", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.agent-board/bin/journal-hook.py\" claude-code", "timeout": 5 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [{ "type": "command", "command": "\"$HOME/.agent-board/bin/journal-hook.py\" claude-code", "timeout": 5 }]
      }
    ]
  }
}
